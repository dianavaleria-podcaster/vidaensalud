# 301 Redirects - Vida En Salud -> dianavaleria.es/podcast
RewriteEngine On

# Redirigir la antigua carpeta del libro y confirmación de Stripe a dianavaleria.es/libro
Redirect 301 /tratado/volumen-1/confirmacion.html https://dianavaleria.es/libro/geometria-de-la-vida/entrega-1/umbral.html
Redirect 301 /vidaensalud.es/tratado/volumen-1/confirmacion.html https://dianavaleria.es/libro/geometria-de-la-vida/entrega-1/umbral.html
RewriteRule ^(vidaensalud\.es/)?libro/dinamica-y-orden-vida(.*)$ https://dianavaleria.es/libro/geometria-de-la-vida$2 [R=301,L]
RewriteRule ^(vidaensalud\.es/)?libro/(.*)$ https://dianavaleria.es/libro/$2 [R=301,L]

# Redirigir la antigua carpeta 'episodios' y 'podcast' a dianavaleria.es/podcast/
RewriteRule ^(vidaensalud\.es/)?episodios/(.*)$ https://dianavaleria.es/podcast/$2 [R=301,L]
RewriteRule ^(vidaensalud\.es/)?podcast/(.*)$ https://dianavaleria.es/podcast/$2 [R=301,L]

# Redirigir suscripción, confirmación y oops a dianavaleria.es/podcast/
Redirect 301 /suscripcion https://dianavaleria.es/podcast/suscripcion/index.html
Redirect 301 /confirmacion https://dianavaleria.es/podcast/confirmacion/index.html
Redirect 301 /oops https://dianavaleria.es/podcast/oops/index.html

# Redirigir la raíz y cualquier otra ruta del podcast a dianavaleria.es/podcast/
RewriteRule ^(vidaensalud\.es/)?(.*)$ https://dianavaleria.es/podcast/$2 [R=301,L]
